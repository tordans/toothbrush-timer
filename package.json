{
  "name": "toothbrush-timer",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "FORCE_COLOR=1 bun --bun vite",
    "build": "bun --bun vite build",
    "preview": "FORCE_COLOR=1 bun --bun vite preview",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs .",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "test-run": "vitest run --passWithNoTests",
    "knip": "KNIP_STRICT=1 knip --config knip.config.mjs",
    "knip-warn": "knip --config knip.config.mjs || true",
    "check": "bun run --parallel type-check lint format test-run knip-warn",
    "check-ci": "bun run --parallel type-check lint-check format-check test-run",
    "check-pre-push": "bun run --parallel type-check lint-check format-check test-run knip api-check",
    "api-up": "docker compose -f api/tests/compose.yml up -d --build --wait",
    "api-down": "docker compose -f api/tests/compose.yml down",
    "api-test": "bun test --cwd api/tests",
    "prepare": "husky",
    "api-check": "bun run api-up && bun run api-test"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "date-fns": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web": "^0.0.359",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "browserslist": "^4.29.5",
    "browserslist-to-esbuild": "^2.1.1",
    "bun-types": "^1.4.4",
    "eslint-plugin-compat": "^7.0.2",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "oxc-transform-react": "^0.156.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "@typescript/typescript-linux-x64": "7.0.2"
  },
  "browserslist": [
    "chrome >= 87",
    "and_chr >= 87",
    "safari >= 15",
    "ios_saf >= 15",
    "firefox >= 115"
  ],
  "trustedDependencies": [
    "eslint-plugin-compat"
  ]
}
