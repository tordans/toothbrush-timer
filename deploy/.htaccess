Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset utf-8
AddType text/javascript .js .mjs
AddType image/svg+xml .svg
AddType font/woff2 .woff2

RewriteEngine On

# HTTPS only (plain http stays possible on localhost for local development)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Hand the Authorization header to PHP (FastCGI strips it)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Never serve dotfiles, but keep /.well-known/ open for the Let's Encrypt validation
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# API: everything under /api to the PHP entry; END stops further rewriting of the result
RewriteRule ^api(/.*)?$ api/index.php [QSA,END]

# Existing files and folders are served as they are
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Missing build files stay 404
RewriteRule ^assets/ - [R=404,L]

# Everything else is the app
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Only this site: no third-party scripts, fonts, images or connections (see docs/datenschutz.md).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self' data:; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"

  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # index.html and the service worker must always be revalidated so a deploy arrives at once
  <If "%{REQUEST_URI} == '/' || %{REQUEST_URI} == '/index.html' || %{REQUEST_URI} == '/sw.js'">
    Header set Cache-Control "no-cache"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
